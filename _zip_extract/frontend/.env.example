# Where the Aven FastAPI backend runs.
VITE_API_BASE_URL=http://localhost:8000

# Must match WEBHOOK_SECRET in backend/.env. Used only by the "sample conversation"
# rehearsal, which posts a transcript to /webhooks/bimpeai. Demo secret only:
# anything prefixed VITE_ is visible in the browser bundle.
VITE_WEBHOOK_SECRET=dev-secret
