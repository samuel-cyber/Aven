DB_PATH=aven.db
WEBHOOK_SECRET=dev-secret
LLM_API_KEY=
LLM_MODEL=
BIMPEAI_API_KEY=
BIMPEAI_AGENT_ID=
BIMPEAI_PHONE_NUMBER=+12017723951

# Voice / BimpeAI advanced (defaults are correct for the hosted API)
BIMPEAI_BASE_URL=https://api.bimpe.ai
BIMPEAI_API_PATH=/api/v1/console
# true = BimpeAI test telephony (any destination). false = live number required.
BIMPEAI_IS_TEST_CALL=true
BIMPEAI_TEST_DESTINATION=test
BIMPEAI_WAIT_TIMEOUT=240
BIMPEAI_POLL_INTERVAL=5

# Where the dashboard looks for the API (used by dashboard/app.py)
API_BASE_URL=http://localhost:8000
